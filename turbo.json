{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "PORT",
    "APP_URL",
    "DATABASE_URL",
    "RUNTIME_DATABASE_URL",
    "METAMCP_RUNTIME_DB_ROLE",
    "BETTER_AUTH_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_BRANDING_PRODUCT_NAME",
    "NEXT_PUBLIC_BRANDING_ORG_NAME",
    "NEXT_PUBLIC_BRANDING_LOGO_PATH",
    "NEXT_PUBLIC_BRANDING_DESCRIPTION",
    "BRANDING_PRODUCT_NAME",
    "BRANDING_ORG_NAME",
    "BRANDING_LOGO_PATH",
    "BRANDING_DESCRIPTION",
    "OIDC_CLIENT_ID",
    "OIDC_CLIENT_SECRET",
    "OIDC_DISCOVERY_URL",
    "OIDC_AUTHORIZATION_URL",
    "OIDC_PKCE",
    "OIDC_SCOPES",
    "OIDC_PROVIDER_ID",
    "TRANSFORM_LOCALHOST_TO_DOCKER_INTERNAL",
    "NODE_ENV",
    "POSTGRES_CA_CERT",
    "LOG_LEVEL",
    "LOG_MAX_SIZE_MB",
    "EXTRA_TRUSTED_ORIGINS",
    "ALLOW_UNAUTHENTICATED_ENDPOINTS",
    "AUTH_SIGNIN_RATE_LIMIT_MAX",
    "AUTH_SIGNIN_RATE_LIMIT_WINDOW_SECONDS",
    "AUTH_SIGNIN_RATE_LIMIT_DISABLED",
    "BOOTSTRAP_USERS",
    "BOOTSTRAP_USER_EMAIL",
    "BOOTSTRAP_USER_PASSWORD",
    "BOOTSTRAP_USER_NAME",
    "BOOTSTRAP_DELETE_OTHER_USERS",
    "BOOTSTRAP_RECREATE_USER",
    "BOOTSTRAP_PRESERVE_API_KEYS",
    "BOOTSTRAP_WARN_PASSWORD_CHANGE",
    "BOOTSTRAP_ONLY_FIRST_RUN",
    "BOOTSTRAP_DISABLE_REGISTRATION_UI",
    "BOOTSTRAP_DISABLE_REGISTRATION_SSO",
    "BOOTSTRAP_API_KEYS",
    "BOOTSTRAP_NAMESPACES",
    "BOOTSTRAP_ENDPOINTS",
    "BOOTSTRAP_DEBUG",
    "BOOTSTRAP_ENABLE",
    "BOOTSTRAP_FAIL_HARD",
    "MCP_SESSION_TTL_DAYS",
    "MCP_SESSION_PRUNER_INTERVAL_MS",
    "PUBLIC_SESSION_TTL_SECONDS",
    "SESSION_SWEEP_INTERVAL_SECONDS",
    "MCP_MAX_SESSIONS_PER_CREDENTIAL",
    "MCP_RECONNECT_BACKOFF_INITIAL_MS",
    "MCP_RECONNECT_BACKOFF_MAX_MS",
    "MCP_RECONNECT_BACKOFF_MULTIPLIER",
    "MCP_RECOVERY_RESET_THRESHOLD_MS",
    "MCP_AUTO_NUKE_ON_CAPABILITY_CHANGE",
    "MCP_ACTIVE_HEALTH_CHECK",
    "MCP_ERROR_PROBE_INTERVAL_MS",
    "MCP_PROXY_URL_ALLOWED_HOSTS",
    "GATEWAY_EVENTS_RETENTION_DAYS",
    "TOOL_AUDIT_RETENTION_DAYS",
    "AUDIT_STORAGE_CHECK_INTERVAL_SWEEPS",
    "AUDIT_STORAGE_WARN_MB",
    "TOOLS_SWEEP_INTERVAL_SECONDS",
    "MAX_TOTAL_CONNECTIONS",
    "MAX_CONNECTIONS_PER_SERVER",
    "MCP_POOL_MIN_CONNECTIONS_PER_NAMESPACE",
    "M365_TENANT_ID",
    "M365_CLIENT_ID",
    "M365_CLIENT_SECRET",
    "M365_TOKEN_KEK",
    "M365_KEK_ID",
    "M365_SCOPES",
    "M365_INJECTED_SERVER_NAMES"
  ],
  // Passed THROUGH to tasks without entering the hash. A secret in
  // `globalEnv` mixes its VALUE into every task's cache key, so each
  // developer's (and each rotation of) the runtime password would miss the
  // whole shared cache. Nothing turbo builds depends on the value; only the
  // running container does.
  "globalPassThroughEnv": ["METAMCP_RUNTIME_DB_PASSWORD"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
