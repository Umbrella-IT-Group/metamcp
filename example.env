NODE_ENV=production
LOG_LEVEL='errors-only' #'all', 'info', 'errors-only', 'none'

# Postgres connection details
#
# POSTGRES_PASSWORD ships as a placeholder that is NOT a working password, on
# purpose. It used to ship a short, memorable default, which meant every copy
# of this file taught the same credential and any deployment that skipped this
# line was guessable by anyone who had read the repository. Replace it before
# the first boot; there is no value here that is safe to leave.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=metamcp_user
POSTGRES_PASSWORD=REPLACE_ME__generate_a_strong_password
POSTGRES_DB=metamcp_db

# Database configuration (composed from above vars)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Application URL configuration
# This is the public URL where your application will be accessible
APP_URL=http://localhost:12008
NEXT_PUBLIC_APP_URL=http://localhost:12008

# Auth configuration
#
# BETTER_AUTH_SECRET ships as a placeholder that is NOT a working secret, on
# purpose, and for a sharper reason than POSTGRES_PASSWORD above. This is the
# SESSION SIGNING KEY: anyone who knows it can mint a session cookie for any
# account without ever seeing a password, and it keys the OAuth
# consent-request signatures too. The literal this line used to carry is
# published in this repository, so every copy taught the same key. Generate
# your own before the first boot:
#
#   openssl rand -hex 32
#
# Changing it later is safe and needs no database work; it invalidates
# existing sessions, so everyone signs in again once.
#
# The placeholder deliberately does NOT match the one on the password lines
# above. An identical string invites a single find-and-replace that sets the
# database password and the session signing key to the same value, which makes
# one leak into two. It also says "signing key" rather than "password",
# because that is what this is.
BETTER_AUTH_SECRET=REPLACE_ME__generate_a_signing_key

# Publish endpoints that have BOTH authentication toggles off (Optional)
#
# DEFAULT (unset, or anything other than the exact string "true"): an endpoint
# whose `enable_api_key_auth` and `enable_oauth` are both off is REFUSED with
# the ordinary 401 challenge, and the backend logs a warning naming it. That
# combination is almost always a mis-set checkbox rather than an intention,
# and before this flag existed it served that namespace's entire tool set to
# anyone who could reach the gateway, with no credential and no audit actor.
#
# SETTING THIS TO true PUBLISHES THOSE ENDPOINTS UNAUTHENTICATED. Every tool
# in the attached namespace becomes callable by any anonymous caller who knows
# the endpoint name. Only set it if that is exactly what you want, and prefer
# a scoped API key over it in every other case.
# ALLOW_UNAUTHENTICATED_ENDPOINTS=false

# OIDC Provider Configuration (Optional)
# Uncomment and configure these variables to enable OpenID Connect authentication
# callback url is ${APP_URL}/api/auth/oauth2/callback/oidc
# Required for OIDC:
# OIDC_CLIENT_ID=your-oidc-client-id
# OIDC_CLIENT_SECRET=your-oidc-client-secret
# OIDC_DISCOVERY_URL=https://your-oidc-provider.com/.well-known/openid-configuration
# OIDC_AUTHORIZATION_URL=https://your-oidc-provider.com/auth

# Optional OIDC Configuration:
# OIDC_PROVIDER_ID=oidc
# OIDC_SCOPES=openid email profile
# OIDC_PKCE=true

# Docker networking fix
TRANSFORM_LOCALHOST_TO_DOCKER_INTERNAL=true

# White-label branding (Optional)
# Leave every var below unset to keep the branding this image ships with.
# Setting one rebrands that surface with no image rebuild — the frontend
# resolves these per request, so a container restart is enough.
# BRANDING_PRODUCT_NAME=Personal MCP Gateway    # browser-tab title
# BRANDING_ORG_NAME=Ivantsov                    # brand name beside the sidebar logo
# BRANDING_DESCRIPTION=A personal MCP gateway.  # <meta name="description">
#
# Custom logo: mount your image into the container's public dir and point
# BRANDING_LOGO_PATH at the path it lands on. In docker-compose.yml:
#   volumes:
#     - ./branding/logo.png:/app/apps/frontend/public/branding/logo.png:ro
# Mount a file or a subdirectory of public/, never public/ itself (that would
# shadow the bundled assets). The file must exist before the container starts.
# BRANDING_LOGO_PATH=/branding/logo.png

# Basic bootstrap configuration
BOOTSTRAP_ENABLE=true # Whether to enable bootstrap configuration. Default: true
BOOTSTRAP_FAIL_HARD=false # Whether a failure to bootstrap should stop the application from initializing. Default: false
BOOTSTRAP_DEBUG=false # Enable debug logging for bootstrap process. Default: false

# ============================================================================
# USER CONFIGURATION
# ============================================================================

# Single User Configuration (Legacy - for simple setups)
# If BOOTSTRAP_USERS is not set, these will be used to create a single user
BOOTSTRAP_USER_EMAIL=test@user.example # Bootstrapped user email.
BOOTSTRAP_USER_NAME=Admin # Bootstrapped user name.
# Bootstrap user password. Ships as a placeholder that is NOT a working
# password. This account is an ADMINISTRATOR of the gateway, so a shipped
# default here is a shipped administrator credential: replace it before the
# first boot. Leaving the placeholder (or the old `changeme` default) in place
# makes the backend log a loud warning on every startup -- see
# `validateConfig` in apps/backend/src/lib/bootstrap.service.ts.
BOOTSTRAP_USER_PASSWORD=REPLACE_ME__generate_a_strong_password

# Multiple Users Configuration (JSON array - recommended for complex setups)
# Each user can have:
#   - email (required): User email address
#   - password (required): User password
#   - name (optional): Display name for the user
#
# Example: BOOTSTRAP_USERS=[{"email":"admin@example.com","password":"pass1","name":"Admin"},{"email":"user@example.com","password":"pass2","name":"User"}]
# BOOTSTRAP_USERS=[{"email":"admin@example.com","password":"admin-password","name":"Administrator"},{"email":"developer@example.com","password":"dev-password","name":"Developer"}]

# User Management Options
BOOTSTRAP_WARN_PASSWORD_CHANGE=true # Whether to log a warning when the password is changed. Default: true
BOOTSTRAP_RECREATE_USER=true # Delete and re-create the bootstrapped user if the password has changed. Default: false
BOOTSTRAP_DELETE_OTHER_USERS=false # Whether to delete users not in the bootstrap configuration. Default: false
BOOTSTRAP_PRESERVE_API_KEYS=true # Whether to preserve existing API keys when recreating users. Default: true
BOOTSTRAP_ONLY_FIRST_RUN=false # Run bootstrap only on first startup. Default: false

# Registration Controls
BOOTSTRAP_DISABLE_REGISTRATION_UI=true # Whether to disable UI registration. Default: true (Umbrella fork; upstream defaults false)
BOOTSTRAP_DISABLE_REGISTRATION_SSO=true # Whether to disable SSO registration. Default: true (Umbrella fork; upstream defaults false)

# ============================================================================
# API KEYS CONFIGURATION (JSON array)
# ============================================================================
# Each API key can have:
#   - name (required): Name for the API key
#   - key (REQUIRED): The key's value, which YOU generate. The database stores only a
#       SHA-256 of it, so bootstrap cannot invent one and show it to you afterwards --
#       there is nowhere to read it back from, and no rotate endpoint to recover with.
#       An entry without "key" is skipped with a warning. Minimum 32 characters; use a
#       high-entropy value (e.g. `openssl rand -hex 32`), because the at-rest hash is
#       unsalted and a guessable key is recoverable from a database read.
#       Re-declaring a different value for an existing key name ROTATES that key.
#   - is_public (optional): Whether the key is public (global) or private (user-scoped). Default: false
#   - user_email (optional): Email of the user who owns this key (for private keys). If not specified, first user is used.
#   - owner (optional): Alias for user_email - both work the same way
#
# Examples:
# Single public key:
# BOOTSTRAP_API_KEYS=[{"name":"Public","is_public":true,"key":"sk_mt_REPLACE_WITH_openssl_rand_hex_32"}]
#
# Multiple keys with different owners (using user_email):
# BOOTSTRAP_API_KEYS=[{"name":"Admin Key","is_public":false,"user_email":"admin@example.com","key":"sk_mt_REPLACE_ME_1"},{"name":"Dev Key","is_public":false,"user_email":"developer@example.com","key":"sk_mt_REPLACE_ME_2"}]
#
# Multiple keys with different owners (using owner):
# BOOTSTRAP_API_KEYS=[{"name":"Admin Key","is_public":false,"owner":"admin@example.com","key":"sk_mt_REPLACE_ME_1"},{"name":"Dev Key","is_public":false,"owner":"developer@example.com","key":"sk_mt_REPLACE_ME_2"}]

# Left unset by default: every entry needs a secret you choose, and shipping a
# placeholder here would either become somebody's real credential or fill the boot
# log with skip warnings. Keys created in the UI are displayed once at mint time.
# BOOTSTRAP_API_KEYS=[{"name":"Public","is_public":true,"key":"sk_mt_REPLACE_WITH_openssl_rand_hex_32"}]

# ============================================================================
# NAMESPACES CONFIGURATION (JSON array)
# ============================================================================
# Each namespace can have:
#   - name (required): Name for the namespace
#   - description (optional): Description for the namespace
#   - is_public (optional): Whether the namespace is public or owned by a user. Default: false
#   - user_email (optional): Email of the user who owns this namespace (for private namespaces). If not specified, first user is used.
#   - owner (optional): Alias for user_email - both work the same way
#   - update (optional): Whether to update the namespace if one with the same name exists. Default: true
#
# Examples:
# Single public namespace:
# BOOTSTRAP_NAMESPACES=[{"name":"Production","description":"Production environment","is_public":true}]
#
# Multiple namespaces with different owners (using user_email):
# BOOTSTRAP_NAMESPACES=[{"name":"Admin Workspace","description":"Admin's private workspace","is_public":false,"user_email":"admin@example.com"},{"name":"Dev Workspace","description":"Developer's workspace","is_public":false,"user_email":"developer@example.com"},{"name":"Shared","description":"Shared namespace","is_public":true}]
#
# Multiple namespaces with different owners (using owner):
# BOOTSTRAP_NAMESPACES=[{"name":"Admin Workspace","description":"Admin's private workspace","is_public":false,"owner":"admin@example.com"},{"name":"Dev Workspace","description":"Developer's workspace","is_public":false,"owner":"developer@example.com"},{"name":"Shared","description":"Shared namespace","is_public":true}]

BOOTSTRAP_NAMESPACES=[{"name":"Default","description":"Default namespace","is_public":true,"update":true}]

# ============================================================================
# ENDPOINTS CONFIGURATION (JSON array)
# ============================================================================
# Each endpoint can have:
#   - name (required): Name for the endpoint
#   - description (optional): Description for the endpoint
#   - enable_auth (optional): Whether to enable API Key authentication. Default: true
#   - enable_auth_query (optional): Whether to enable query parameter authentication. Requires enable_auth=true. Default: false
#   - enable_auth_oauth (optional): Whether to enable OAuth for the endpoint. Default: false
#   - is_public (optional): Whether the endpoint is public or owned by a user. Default: true
#   - user_email (optional): Email of the user who owns this endpoint (for private endpoints). If not specified, first user is used.
#   - owner (optional): Alias for user_email - both work the same way
#   - namespace (optional): Name of the namespace where this endpoint should be created. If not specified, first available namespace is used.
#   - update (optional): Whether to update the endpoint if one with the same name exists. Default: true
#
# Note: If namespace is not specified, endpoints will be created in the first available namespace.
#
# Examples:
# Single public endpoint (in first available namespace):
# BOOTSTRAP_ENDPOINTS=[{"name":"api","description":"Public API","enable_auth":false,"is_public":true}]
#
# Endpoints in specific namespaces:
# BOOTSTRAP_ENDPOINTS=[{"name":"admin-api","namespace":"Admin Workspace","enable_auth":true,"is_public":false,"user_email":"admin@example.com"},{"name":"dev-api","namespace":"Dev Workspace","enable_auth":true,"is_public":false,"user_email":"developer@example.com"}]
#
# Multiple endpoints with different owners (using user_email):
# BOOTSTRAP_ENDPOINTS=[{"name":"admin-api","description":"Admin API","enable_auth":true,"is_public":false,"user_email":"admin@example.com"},{"name":"dev-api","description":"Dev API","enable_auth":true,"is_public":false,"user_email":"developer@example.com"},{"name":"public-api","description":"Public API","enable_auth":false,"is_public":true}]
#
# Multiple endpoints with different owners (using owner):
# BOOTSTRAP_ENDPOINTS=[{"name":"admin-api","description":"Admin API","enable_auth":true,"is_public":false,"owner":"admin@example.com"},{"name":"dev-api","description":"Dev API","enable_auth":true,"is_public":false,"owner":"developer@example.com"},{"name":"public-api","description":"Public API","enable_auth":false,"is_public":true}]

# NOTE: this example endpoint sets every auth toggle to false, which is the
# both-toggles-off case ALLOW_UNAUTHENTICATED_ENDPOINTS governs (see the Auth
# configuration section above). As shipped it will be REFUSED with a 401 until
# you either turn on `enable_auth` / `enable_auth_oauth` here, or set
# ALLOW_UNAUTHENTICATED_ENDPOINTS=true to publish it unauthenticated on
# purpose. Turning an auth toggle on is the right answer in almost every case.
BOOTSTRAP_ENDPOINTS=[{"name":"Public","description":"Public endpoint","enable_auth":false,"enable_auth_query":false,"enable_auth_oauth":false,"is_public":true,"update":true}]


# Extra trusted origins (comma-separated). Useful for cluster deployments where
# different ports/origins are needed.
#
# THIS IS A THREE-CONSUMER TRUST KNOB. An origin listed here is granted all of:
#   1. Better Auth's `trustedOrigins` — its CSRF/redirect allowlist.
#   2. Credentialed CORS on /api/auth/* — the session relay. The listed origin
#      may READ session responses cross-origin, sign-in included.
#   3. Credentialed CORS on /metamcp/* — the public MCP endpoints.
# So adding an origin to unblock a browser-based MCP client also hands that
# origin cross-origin read access to the authentication surface. Add only
# origins you would trust with a signed-in user's session; http:// entries make
# that grant available to anything that can spoof the DNS name. Entries must be
# http(s) absolute origins — any other scheme is ignored.
# EXTRA_TRUSTED_ORIGINS=https://myapp.example.com,https://myapp.example.com:8080

# ============================================================================
# UMBRELLA FORK CONFIGURATION
# ============================================================================
# Knobs that exist only in this fork (ghcr.io/umbrella-it-group/metamcp).
# All are optional — each falls back to the code default shown in its comment.
# This is the subset worth setting on a new deployment; the full list
# (MCP_* recovery/pruner knobs, LOG_MAX_SIZE_MB, TOOL_AUDIT_RETENTION_DAYS,
# GATEWAY_EVENTS_RETENTION_DAYS, TOOLS_SWEEP_INTERVAL_SECONDS,
# PUBLIC_SESSION_TTL_SECONDS, ...) is documented in README.md § Configuration.

# --- Sign-in rate limiting ---
# The password-carrying POSTs (`POST /api/auth/sign-in/email` and
# `POST /api/auth/sign-up/email`) are capped per client IP, keyed on the
# edge-supplied CF-Connecting-IP header the fork's other limiters already use.
# Sign-up is capped alongside sign-in because it also carries a password and,
# with signup disabled, every POST writes an append-only audit row. Requests
# arriving WITHOUT that header are exempt rather than pooled into one shared
# bucket: a shared bucket would let any single caller lock the whole
# organisation out, which is the same defect that keeps better-auth's own
# limiter pinned off here.
#
# The rest of /api/auth is not capped — SSO entry and callbacks, session reads,
# sign-out and dynamic client registration carry no password, and refusing them
# breaks flows rather than bounding one.
#
# Attempts per window, per client IP. Unparseable, zero and negative values
# fall back to this default with a boot warning instead of being honoured (a 0
# would refuse every sign-in); anything above 1000 is capped.
# AUTH_SIGNIN_RATE_LIMIT_MAX=20
#
# Window length in seconds. Same fallback rule — a 0 would expire the window on
# every request and silently remove the limit. Capped at 86400 (24h).
# AUTH_SIGNIN_RATE_LIMIT_WINDOW_SECONDS=600
#
# Off switch, and the only way to turn the limiter off. Exactly the word "true";
# 1, yes and TRUE all leave it ON, because a control that removes a brute-force
# bound should not be openable by a near-miss spelling.
# AUTH_SIGNIN_RATE_LIMIT_DISABLED=true

# --- Gateway activity history ---
# How long the durable Live Logs history (`gateway_events`) is kept. Rows are
# immutable for their first 30 days at the database level, so values below 30
# are raised to 30 with a warning at boot rather than silently ignored. There
# is no "keep forever" value: this table records connection, client, server and
# system activity, and unbounded retention on it is unbounded growth.
# GATEWAY_EVENTS_RETENTION_DAYS=90

# --- Audit storage tripwire ---
# The three audit tables (`audit_log`, `gateway_events`, `tool_call_audit`) are
# measured on the cleanup sweep and their estimated rows and on-disk size are
# logged. Two of them are immutable for 30 days at the database level, so no
# application path can reclaim in-window space and lowering a retention value
# does nothing until the window passes. Knowing early is the defence, which is
# why this reports on every check rather than only on a threshold crossing.
#
# NOTE the LOG_LEVEL dependency: the per-check reading is an INFO line, and
# the console mirror only carries INFO at LOG_LEVEL=info or all. Left unset
# (default errors-only, floor WARN) the reading still reaches the in-container
# application log but never stdout, so a log shipper will not see it. The
# threshold warning below is a WARN and ships at every level except none, and
# its gateway_events row is written whatever LOG_LEVEL says.
#
# How many 5-minute cleanup sweeps between checks. Values below 1 fall back to
# the default (there is deliberately no off switch), and anything above 288
# is capped to 288 so the numbers land at least once a day.
# AUDIT_STORAGE_CHECK_INTERVAL_SWEEPS=12
#
# Per-table size that escalates the log line from INFO to WARN and writes a
# `system` event into the gateway history, so the warning appears in the
# History view rather than only in the log stack. At most one warning per
# table per day while the condition lasts. Capped at 1048576 (1 TiB) so a
# threshold nothing can reach cannot be used to mute the warning.
# AUDIT_STORAGE_WARN_MB=2048

# --- OAuth and session lifetimes ---
# Upstream hardcodes a 1h access token, which disconnects Claude.ai custom
# connectors hourly. These are the fork's max-connectivity defaults.
OAUTH_ACCESS_TOKEN_TTL_SECONDS=86400 # MCP OAuth access-token lifetime. Default: 86400 (24h)
OAUTH_REFRESH_TOKEN_TTL_SECONDS=31536000 # MCP OAuth refresh-token lifetime; rotates on use. Default: 31536000 (365d)
BETTER_AUTH_SESSION_EXPIRES_IN_SECONDS=2592000 # Better-auth session cookie lifetime. Default: 2592000 (30d)
BETTER_AUTH_SESSION_UPDATE_AGE_SECONDS=604800 # Better-auth sliding session refresh age. Default: 604800 (7d)

# --- Connection pool caps ---
# NOTE: the values below are the production-tested settings, NOT the code
# defaults — both code defaults were exhausted under real load. Raise or
# lower to fit your backend count, but do not leave them at a value your
# steady-state session population can reach: on saturation every new connect
# LRU-evicts a live backend connection, and victims see transient
# "Failed to re-initialize session after backend session loss" tool errors.
MAX_CONNECTIONS_PER_SERVER=50 # Per-backend connection cap. Code default 5 trips under normal load ("Session not found")
MAX_TOTAL_CONNECTIONS=400 # Global backend-connection cap (soft LRU bound). Code default 100 saturated in ~3h in prod

# --- Dynamic client registration (DCR) redirect_uri allowlist ---
# `POST /oauth/register` is anonymous, so any host it accepts is a host a
# signed-in user can be phished into approving on the consent screen. This
# fork restricts non-loopback redirect URIs to an exact-match host allowlist
# (security review finding: redirect_uri was validated by scheme only). Loopback
# (localhost / 127.0.0.1 / ::1, any port except the gateway's own 12009) is
# always accepted regardless of this setting — that is the installed-client
# case.
#
# LEAVE UNSET to keep the built-in default: claude.ai, claude.com,
# anthropic.com. Setting it REPLACES that default rather than extending it, so
# list every host you need including the Anthropic ones. An explicitly EMPTY
# value means "loopback only".
# DCR_REDIRECT_URI_ALLOWED_HOSTS=claude.ai,claude.com,anthropic.com

# --- mcp-proxy remote-URL destination allowlist ---
# The Inspector's SSE / streamable-HTTP connect takes its target URL from the
# request and has the BACKEND open the connection, forwarding the caller's
# Authorization header. That is admin-gated by a session cookie, and a
# SameSite=Lax cookie rides along on a top-level GET — so without a destination
# check any page an admin visits can aim the backend at an internal address
# (server-side request forgery). This fork refuses any URL whose host resolves
# into a non-public range: loopback, RFC 1918, link-local (including the
# 169.254.169.254 cloud instance-metadata address), CGNAT, multicast and their
# IPv6 equivalents.
#
# LEAVE UNSET for the default posture: block internal, allow anything public.
# Connecting to a public MCP server that is not saved in the database yet is
# unaffected and still works.
#
# Set it ONLY if you deliberately front an MCP server on a private address.
# The common case is TRANSFORM_LOCALHOST_TO_DOCKER_INTERNAL=true — which is the
# DEFAULT in this file and in the shipped compose, not just a local-development
# choice. It rewrites a localhost URL to host.docker.internal, which resolves
# into the Docker bridge network, so any deployment that actually points the
# proxy at a localhost MCP server needs the entry below to keep connecting.
#
# AN ENTRY EXEMPTS ONLY THE URL YOU TYPE. It does not travel: a redirect to an
# allowlisted host, or an SSE back-channel endpoint the remote server points at
# one, is still refused. Otherwise an entry meant to unblock your own internal
# host would let any public server 302 the gateway into it.
#
# Exact hostname match, comma-separated; each entry skips the range check for
# that host at the connect URL only. An allowlisted host is trusted by NAME, so
# it is also the one case where the connection is not pinned to a
# pre-validated address.
#
# THIS ALLOWLIST APPLIES TO THE INSPECTOR PATH ONLY. The pooled data plane
# (the namespace backends served to connectors) dials DB-configured internal
# services, so it uses a different posture, not this allowlist: it permits the
# RFC 1918 / loopback ranges where those backends live (the socket is still
# pinned to the resolved address and the cloud metadata address is still
# refused) and it refuses any redirect to another origin outright. No allowlist
# entry is needed to keep an internal backend connecting.
# MCP_PROXY_URL_ALLOWED_HOSTS=host.docker.internal

# --- mcp-proxy response size and time caps (optional) ---
# Both the Inspector's guarded fetch and the pooled data plane bound every
# upstream response, so a hostile or misbehaving MCP backend cannot exhaust
# gateway memory or stall a pool slot forever.
#
# MCP_PROXY_MAX_RESPONSE_BYTES caps the bytes read from a single response body
# before the request is aborted (default 104857600, i.e. 100 MiB). It is a
# memory-exhaustion backstop, not an operational limit; a JSON-RPC response
# never approaches it. On a long-lived SSE stream the count is cumulative over
# the connection, so keep the default generous.
#
# MCP_PROXY_REQUEST_TIMEOUT_MS is the pinned dispatcher's headers-and-body IDLE
# timeout in ms (default 300000). It is reset on every received chunk, NOT a
# total-duration cap, so it bounds a hung or stalled upstream without severing
# a legitimately long-lived, active SSE stream.
# MCP_PROXY_MAX_RESPONSE_BYTES=104857600
# MCP_PROXY_REQUEST_TIMEOUT_MS=300000

# --- gateway backend trust header (optional; staged rollout) ---
# When GATEWAY_BACKEND_SECRET is set, every upstream request the gateway makes
# to an INTERNAL backend carries it in the X-Gateway-Auth header: the pooled SSE
# and Streamable-HTTP transports, the Inspector, and each redirect hop. A
# backend that enforces the header can then refuse anything that did not arrive
# through the gateway. It is sent ONLY to destinations the URL guard classifies
# as internal (every resolved address in an RFC 1918 / loopback range, or a host
# trusted by name via MCP_PROXY_URL_ALLOWED_HOSTS); an external server a user
# configures never receives it, and any inbound value is stripped before the
# request goes out so a stored server-row header cannot forge one.
#
# When unset, nothing is sent and the gateway logs one warning at boot, so the
# backends can be deployed permissive first and the secret turned on afterwards.
# The value must be at least 32 bytes; a shorter value is ignored (treated as
# unset) rather than sent, because a weak shared secret is worse than none. It is
# never logged. It is a secret, so it is passed through to the container without
# entering any build-cache key (turbo globalPassThroughEnv).
# GATEWAY_BACKEND_SECRET=replace-with-at-least-32-random-bytes

# --- NOSUPERUSER runtime database role (optional, off by default) ---
# WHAT IT FIXES. On the shipped compose stack the gateway connects with
# DATABASE_URL, which on the postgres:16-alpine image is the cluster bootstrap
# SUPERUSER, and that one credential serves both `drizzle-kit migrate` and the
# running app. Superusers bypass GRANTs and can disable or drop a trigger, so
# the append-only triggers on `audit_log` are bypassable by the credential the
# gateway holds every second it is running. Migrations genuinely need that
# privilege. Serving requests does not.
#
# SET METAMCP_RUNTIME_DB_PASSWORD to turn the split on. The entrypoint then
# creates/converges a NOSUPERUSER LOGIN role (see scripts/ensure-runtime-role.sh)
# after migrations and before the servers start, grants it ordinary DML on the
# application tables, and revokes the verbs that define immutability:
# `audit_log` keeps INSERT + SELECT only; `tool_call_audit` also keeps DELETE
# so its retention pruner still works, but never UPDATE or TRUNCATE.
# The backend logs which role it authenticated as, and whether that role is a
# superuser, on every boot.
#
# LEAVE UNSET and nothing changes: the gateway connects with DATABASE_URL
# exactly as before, and the entrypoint step is skipped entirely.
#
# Use a strong value — this is a real database login.
#
# ROTATING IT is a full stop/start, not a rolling one. The role's password is
# re-asserted on every container start, which is seamless for a SINGLE app
# container: it rotates and then connects with the new value. With two
# replicas, or during a rolling restart, the first container to boot rotates
# the password out from under every sibling still holding a pool on the old
# one, and those siblings fail authentication on their next connection. Stop
# all app containers, then start them.
#
# The dev stack honours this variable too (docker-compose.dev.yml runs the
# same ensure-role step), so a value set here applies to both.
# METAMCP_RUNTIME_DB_PASSWORD=REPLACE_ME__generate_a_strong_password
# METAMCP_RUNTIME_DB_ROLE=metamcp_runtime # Role name. Default: metamcp_runtime
#
# RUNTIME_DATABASE_URL is the escape hatch for a topology the derivation above
# cannot express — a separate host, a connection pooler in front of the runtime
# role, or a managed instance where the role is provisioned outside this repo.
# It is used VERBATIM and wins over METAMCP_RUNTIME_DB_PASSWORD. Setting it
# alone does NOT run the entrypoint's ensure-role step: you are telling the
# gateway which credential to use, and taking responsibility for its grants.
# Setting BOTH is legal but rarely what you want — the entrypoint would
# converge the role named above while the gateway dials the string below.
# RUNTIME_DATABASE_URL=postgresql://metamcp_runtime:...@postgres:5432/metamcp_db
